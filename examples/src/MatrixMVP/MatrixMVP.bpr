<?xml version='1.0' encoding='utf-8' ?>
<!-- C++Builder XML Project -->
<PROJECT>
  <MACROS>
    <VERSION value="BCB.06.00"/>
    <PROJECT value="MatrixMVP.exe"/>
    <OBJFILES value="console_settings_keeper.obj ConsoleView.obj main.obj MatrixModel.obj 
      MatrixTypes.obj Presenter.obj signal_impl.obj"/>
    <RESFILES value="MatrixMVP.res"/>
    <IDLFILES value=""/>
    <IDLGENFILES value=""/>
    <DEFFILE value=""/>
    <RESDEPEN value="$(RESFILES)"/>
    <LIBFILES value=""/>
    <LIBRARIES value=""/>
    <SPARELIBS value="rtl.lib"/>
    <PACKAGES value="vcl.bpi rtl.bpi vclx.bpi dbrtl.bpi vcldb.bpi bdertl.bpi visualclx.bpi 
      bcbsmp.bpi bcbie.bpi dclocx.bpi bcb2kaxserver.bpi xmlrtl.bpi inet.bpi 
      dsnap.bpi soaprtl.bpi vclie.bpi inetdbbde.bpi inetdbxpress.bpi teeqr.bpi 
